<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Do not allow any backup of app data for security -->
    <cloud-backup>
        <!-- Disable cloud backup entirely -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    
    <!-- Device transfer rules -->
    <device-transfer>
        <!-- Disable device transfer for security -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
    
    <!-- Media transfer -->
    <media-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </media-transfer>
</data-extraction-rules>